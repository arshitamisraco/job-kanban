# Secret used by next-auth to sign/encrypt session tokens. Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Base URL the app is served from (used for OAuth callback URLs).
AUTH_URL=http://localhost:3000
# OAuth 2.0 Web client credentials from Google Cloud Console (Gmail API enabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this email is allowed to sign in (single-user app).
ALLOWED_EMAIL=
# Optional: Anthropic API key for LLM-based email classification. Falls back to a heuristic classifier if unset.
ANTHROPIC_API_KEY=
# Set to 1 to skip Google auth and Gmail, using src/mock/emails.json and a fake session instead.
# In mock mode, ALLOWED_EMAIL and AUTH_SECRET are NOT required (they default to
# "mock@example.com" and an auto-generated dev secret) -- only needed for real Google sign-in.
MOCK_MODE=
# Also set for the client bundle so the frontend skips next-auth's sign-in screen.
NEXT_PUBLIC_MOCK_MODE=
# Days of Gmail history to scan on the very first sync (default 90 if unset).
INITIAL_LOOKBACK_DAYS=90
